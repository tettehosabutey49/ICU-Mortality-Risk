   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.read_csv('data/raw/patient_survival.csv')\n",
    "sample = df.groupby('hospital_death', group_keys=False).apply(\n",
    "    lambda x: x.sample(min(len(x), 4500), random_state=42)\n",
    ")\n",
    "sample.to_csv('demo_data.csv', index=False)"
   ]
  },
